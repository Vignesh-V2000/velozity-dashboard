{
  "name": "velozity-dashboard",
  "version": "1.0.0",
  "description": "Velozity Global Solutions — Real-Time Project Dashboard (monorepo)",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "db:migrate": "npm run db:migrate --prefix server",
    "db:seed": "npm run db:seed --prefix server",
    "db:generate": "npm run db:generate --prefix server",
    "db:reset": "npm run db:reset --prefix server",
    "build:server": "npm run build --prefix server",
    "build:client": "npm run build --prefix client"
  }
}
